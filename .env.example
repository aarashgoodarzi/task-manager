# HTTP server
PORT=8080

# PostgreSQL connection string. Required: the service refuses to start without
# it, pings the server, and verifies the schema. Create the database and apply
# the embedded migrations with `make migrate` before the first run.
DATABASE_URL=postgres://user:pass@localhost:5432/task_manager?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m

# Logging
LOG_LEVEL=info

# Observability. tasks_count is re-read from PostgreSQL on this interval; it is
# served, with request metrics, at GET /metrics on the HTTP port. Must be
# positive; invalid values fall back to 15s.
METRICS_TASKS_REFRESH_INTERVAL=15s

# Integration tests only. Read by `go test` and `make test-integration`, not by
# the service. The database name must contain "test": the suites truncate the
# tasks table between cases.
TEST_DATABASE_URL=postgres://user:pass@localhost:5432/task_manager_test?sslmode=disable
